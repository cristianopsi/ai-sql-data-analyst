# Application
APP_NAME=AI SQL Data Analyst
APP_ENV=development
APP_DEBUG=false

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8501

# Streamlit
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8501

# PostgreSQL container bootstrap
POSTGRES_DB=ai_sql_data_analyst
POSTGRES_USER=ai_sql_admin
POSTGRES_PASSWORD=

# Application and read-only analytics connections
DATABASE_URL=
ANALYTICS_DATABASE_URL=

# LLM provider
# Supported progressively: mock, openai, gemini, groq, openrouter, ollama
LLM_PROVIDER=mock
LLM_MODEL=deterministic-test
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1200
LLM_REQUEST_TIMEOUT_SECONDS=30

# Query safety
QUERY_TIMEOUT_SECONDS=10
STATEMENT_TIMEOUT_MS=8000
MAX_RESULT_ROWS=1000
MAX_SQL_REPAIR_ATTEMPTS=2
MAX_QUESTION_LENGTH=2000

# Context and cache
SCHEMA_CACHE_TTL_SECONDS=300
CONVERSATION_HISTORY_LIMIT=10

# Logging, audit and metrics
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_LOG_ENABLED=true
AUDIT_RETENTION_DAYS=30
METRICS_ENABLED=true
